#!/usr/bin/env bash
# Runs after every successful `git merge` (including a plain `git pull`) on the
# server. Two independent steps, each only when its paths actually changed:
#   - database/migrations/ changed -> php artisan migrate --force
#   - aset Inertia berubah          -> npm ci + npm run build (vite klien & SSR)
#
# Ini jaring pengaman untuk `git pull` MANUAL di server. Rilis yang benar
# dijalankan lewat scripts/deploy.sh, yang sengaja MELEWATI hook ini
# (core.hooksPath diarahkan ke folder yang tidak ada) karena urutan di sini
# salah untuk rilis: migrate jalan sebelum composer install, padahal migrasi
# bisa butuh paket yang baru ditambahkan.
#
# One-time activation on the server (this file lives in git, .git/hooks does not):
#   git config core.hooksPath deploy/hooks
#
# Caveats:
# - Assumes `git pull` merges (default). If pull.rebase is set, this hook never
#   fires -- rebase doesn't trigger post-merge.
# - migrate runs unattended with --force (no interactive "in production?"
#   prompt, no automatic backup) -- a bad migration in the pulled commit applies
#   immediately on pull.
# - hPanel's Node.js selector puts npm outside the default SSH PATH; the asset
#   step sources the nodevenv activate script itself (same shape of problem as
#   the composer2 php.ini gotcha documented in CLAUDE.md).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

OLD_HEAD="$(git rev-parse ORIG_HEAD 2>/dev/null || echo "")"
NEW_HEAD="$(git rev-parse HEAD)"

# True if $1 changed between OLD_HEAD and NEW_HEAD. If OLD_HEAD is unknown
# (e.g. first pull on this checkout) treat it as changed, to be safe.
changed() {
  if [ -z "$OLD_HEAD" ]; then
    return 0
  fi
  ! git diff --quiet "$OLD_HEAD" "$NEW_HEAD" -- "$1"
}

if changed "database/migrations/"; then
  echo "post-merge: database/migrations/ changed, running php artisan migrate..."
  php artisan migrate --force
else
  echo "post-merge: no changes under database/migrations/, skipping migrate"
fi

# Sumber aset Inertia. Folder `frontend/` SENGAJA tidak ada di daftar ini:
# sejak pindah ke Inertia (7 September 2026) isinya cuma sisa arsip dan
# package.json-nya sudah dipindah ke frontend_backup/, jadi hook versi lama
# yang menjalankan `npm --prefix frontend ci` selalu mati di sini.
ASSET_PATHS="resources/js resources/css package.json package-lock.json vite.config.js"

assets_changed=0
for path in $ASSET_PATHS; do
  if changed "$path"; then
    assets_changed=1
    break
  fi
done

if [ "$assets_changed" -eq 1 ]; then
  echo "post-merge: aset Inertia berubah, menjalankan vite build..."

  if ! command -v npm >/dev/null 2>&1; then
    NODEVENV_ACTIVATE="$(find "$HOME/nodevenv" -maxdepth 3 -name activate 2>/dev/null | head -n1 || true)"
    if [ -n "$NODEVENV_ACTIVATE" ]; then
      # shellcheck disable=SC1090
      . "$NODEVENV_ACTIVATE"
    fi
  fi

  if ! command -v npm >/dev/null 2>&1; then
    echo "post-merge: npm not found in PATH, skipping asset build" >&2
    echo "post-merge: jalankan 'scripts/deploy.sh --assets' dari laptop untuk menambalnya" >&2
  else
    # --include=dev memaksa devDependencies (vite, typescript, tailwind)
    # terpasang berapa pun NODE_ENV-nya -- Node.js Selector harus tetap di
    # mode "Production", jadi NODE_ENV tidak bisa diandalkan di sini.
    npm ci --include=dev
    # = vite build && vite build --ssr. Yang pertama mengisi public/build
    # berikut manifest.json, yang kedua bootstrap/ssr/ssr.js. Keduanya
    # gitignored dan memang dibangun di server.
    npm run build

    # Gagal keras kalau manifest tidak terbentuk: tanpa itu SETIAP halaman
    # mati dengan ViteManifestNotFoundException, dan hook yang exit 0 akan
    # menyembunyikannya sampai ada yang membuka situs.
    if [ ! -f public/build/manifest.json ]; then
      echo "post-merge: public/build/manifest.json tidak terbentuk -- build gagal" >&2
      exit 1
    fi

    echo "post-merge: aset Inertia ter-build ke public/build"
  fi
else
  echo "post-merge: aset Inertia tidak berubah, skipping build"
fi
