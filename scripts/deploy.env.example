# Konfigurasi server untuk scripts/deploy.sh
#
# Salin file ini jadi scripts/deploy.env (yang di-gitignore) lalu isi nilainya.
# JANGAN commit scripts/deploy.env -- repo ini publik, dan isinya adalah detail
# akses server.
#
#   cp scripts/deploy.env.example scripts/deploy.env
#
# Cara mencari nilainya, dari cPanel Terminal server:
#   hostname -f                 -> nama server
#   curl -s https://ipinfo.io/ip -> IP publik
#   pwd (di dalam folder repo)  -> DEPLOY_REMOTE_APP
# Port SSH biasanya tidak terbaca dari sshd_config oleh user biasa; cek di
# cPanel -> Security -> SSH Access, atau tes: ssh -p <port> user@host

DEPLOY_SSH_USER=""          # username cPanel, mis. "namaakun"
DEPLOY_SSH_HOST=""          # hostname atau IP server
DEPLOY_SSH_PORT="22"        # sering BUKAN 22 -- konfirmasi dulu
DEPLOY_SSH_KEY="$HOME/.ssh/amanafinance_deploy"

DEPLOY_REMOTE_APP=""        # path absolut repo di server, mis. "/home/user/app"
DEPLOY_SITE_URL=""          # mis. "https://staging.contoh.id" (tanpa slash akhir)
DEPLOY_BRANCH="main"        # branch yang di-checkout di server
